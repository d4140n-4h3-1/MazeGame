(* System Latin: formal grammar, spec v1.0
   Notation: ISO-style EBNF. Terminals are lowercase ASCII words from sl_lexicon.json
   or generated by the verb paradigm. Side conditions are written as (? ... ?).
   Canonical input: lowercase ASCII; macrons stripped; only  . , : ?  as punctuation. *)

message        = [ envelope ] , sentence , { sentence } | envelope ;   (* strict mode requires the envelope *)

(* ---------------------------------------------------------------- envelope (v1.1) *)
envelope       = "nuntius" , "codex" , digit , { digit } , ":" , field , { "," , field } , "." ;
field          = "ab" , np                                   (* sender: np must carry a code *)
               | "ad" , np                                   (* receiver: np with a code, or quantity "omnia" *)
               | "prioritas" , level
               | "responsum" , "codex" , digit , { digit }
               | "tempus" , numeral ;
level          = "minimum" | "humile" | "normale" | "altum" | "maximum" ;
(? "ab" and "ad" are required; each field appears at most once; the envelope is the first sentence ?)
sentence       = [ { "sed" | "tamen" } ] , body , ( "." | "?" ) ;   (* leading discourse connectors strip off the sentence, not the subject np *)
body           = rule | else_clause | end_marker | purpose | question | statement ;

(* ---------------------------------------------------------------- rules *)
rule           = ( "si" | "nisi" | "quando" | "dum" | "donec" ) , condition , "," , actions
               | "quisque" , np , "," , actions ;
else_clause    = "aliter" , "," , actions
               | "aliter" , "si" , condition , "," , actions ;
end_marker     = "finis" ;
(? else_clause must directly follow a "si"/"nisi" rule or another "aliter si" sentence;
   "finis" or any other sentence closes the chain ?)
(? "quando" is a rule only when the sentence ends in "."; with "?" it is a question ?)
(? rules do not nest: no rule keyword may begin an action ?)

condition      = conjunction , { "aut" , conjunction } ;
conjunction    = atom , { "et" , atom } ;                 (* "et" binds tighter than "aut" *)
atom           = finite | status | comparison ;

actions        = ( "tunc" | () ) , action , { "," , action } ;   (* "tunc" only in the first slot *)
action         = ( command | finite | status ) , [ subordinate ] ;
subordinate    = ( "donec" | "dum" ) , condition ;

(* ---------------------------------------------------------------- clauses *)
statement      = action , { "," , action } | answer | nominal ;
command        = [ "non" ] , cmd , verb_tail ;              (* cmd = stem + "a"  *)
finite         = [ np ] , [ "non" ] , fin , verb_tail          (* fin = person/tense form *)
               | np , [ "non" ] , pass , { modifier } ;         (* pass = -atur / -antur / -absatur ... *)
verb_tail      = [ embedded_q | infinitive | np ] , { modifier } ;
(? an intransitive verb (lexicon valency = intrans) takes no np ?)
infinitive     = inf , [ np ] , { modifier } ;                  (* inf = stem + "are" *)
status         = [ np ] , [ "non" ] , predicate , { modifier }
               | np , { modifier_pp } ;                         (* "systema in initializatio" *)
predicate      = stat | ing | adj | adv ;                       (* stat = -atum ; ing = -ans *)
(? if a status clause has no explicit predicate, the last adjective of its np is the predicate ?)
comparison     = np , [ "non" ] , ( "aequale" | "maius" | "minus" ) , np ;
nominal        = np ;
answer         = "affirmatum" | "negativum" | numeral ;
modifier       = prep , np | adv ;
modifier_pp    = prep , np ;
purpose        = np , ":" , ( infinitive | actions ) ;

(* ---------------------------------------------------------------- questions *)
question       = "utrum" , clause_any
               | [ prep ] , qword , [ np ] , [ clause_any ] ;
embedded_q     = ( "utrum" | qword ) , clause_any ;             (* no "?" inside; the outer sentence ends it *)
qword          = "quis" | "quid" | "quale" | "ubi" | "cur" | "quomodo" | "quantum" | "quando" ;
clause_any     = infinitive | command | finite | status | comparison | nominal ;
(? a sentence ending in "?" must be a question; a question must end in "?" ?)

(* ---------------------------------------------------------------- noun phrases *)
np             = [ article ] , [ demonstrative ] , codex_np
               | [ article ] , [ demonstrative ] , [ quantity ] , head , { adj } , [ [ demonstrative ] , dependent , { adj } ]
               | demonstrative ;                                (* a demonstrative alone is a pronoun *)
codex_np       = "codex" , digit , { digit } ;
head           = noun | pron ;
dependent      = noun | pron | codex_np ;                       (* at most one *)
article        = "to" | "ta" | "ti" ;                            (* at most one article per np; always requires a noun to follow *)
demonstrative  = "hic" | "ille" | "idem" | "alius" ;
quantity       = numeral | "omnia" | "multum" | "nullum" | "aliquid" ;
(? a numeral or quantity word may stand alone as an np ?)
(? three adjacent nouns are an error (E_NOUNS) ?)
(? an adjective directly after a noun is attributive unless it is the last word of its clause ?)

(* ---------------------------------------------------------------- numerals *)
numeral        = "ordo" , integer
               | [ "negatum" ] , integer , [ "punctum" , digit , { digit } ] ;
integer        = "zero"
               | [ group , "milio" | "milio" ] , [ group , "mille" | "mille" ] , [ group ] ;   (* at least one part *)
group          = [ hundreds ] , [ tens ] , [ ones ] ;              (* at least one part, below 1000 *)
hundreds       = digit_2_9 , "centum" | "centum" ;
tens           = digit_2_9 , "decem" | "decem" ;
ones           = digit_1_9 ;
digit          = "zero" | digit_1_9 ;
digit_1_9      = "unum" | digit_2_9 ;
digit_2_9      = "duo" | "tria" | "quattuor" | "quinque" | "sex" | "septem" | "octo" | "novem" ;
(? "unum" never precedes a place word: one spelling per value ?)

(* -------------------------------------------------------- derived adverbs *)
(* Any adjective (surface form ending "-um") has a corresponding manner adverb,
   formed by dropping "-um" and adding "-iter": fortum -> fortiter.
   Temporal/frequency words (nunc, iam, semper, numquam, statim, postea, iterum)
   are a separate closed class and are not derived. *)

(* ---------------------------------------------------------------- morphology *)
(* Every verb has a stem s (command = s + "a"). Endings are appended to s:
   fin     : o as at amus atis ant                  present
             av+ending                              past      (avo, avas, avat, avamus, avatis, avant)
             abs+ending                             future    (abso, absas, absat, absamus, absatis, absant)
   pass    : atur antur absatur absantur
   inf     : are        ing : ans        req : andum
   stat    : atum       (stems ending in "ct": um)
   noun    : atio       (stems ending in "ct": io)  agent : ator  (stems ending in "ct": or)  *)
